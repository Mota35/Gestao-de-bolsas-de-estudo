# URL base da API REST (sem barra final). Se estiver vazia, a aplicação corre em modo de demonstração.
VITE_API_URL=
# true = dados fictícios identificados como demonstração (sem chamadas à API)
VITE_DEMO_MODE=true
# Data de referência dos dados de demonstração (AAAA-MM-DD)
VITE_DEMO_REFERENCE_DATE=2026-10-26
# Número de suporte/contactos de exemplo (nunca colocar segredos aqui)
VITE_SUPPORT_EMAIL=suporte@kwanza.example
