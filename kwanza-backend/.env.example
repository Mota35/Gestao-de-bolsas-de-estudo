# --- Copie para .env e ajuste. NUNCA faça commit do .env. ---
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kwanza?schema=public

# Segredo para assinar access tokens (>= 32 caracteres). Gere com: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-long-random-secret-value

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Cookies (SameSite=lax serve se frontend e API partilham o "site"; em domínios diferentes use none, só em produção com HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.exemplo.ao
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Email (em desenvolvimento "outbox" grava os emails em ficheiros .dev-mail/ - os links de recuperação NÃO vão para os logs)
MAIL_TRANSPORT=outbox
MAIL_FROM="Kwanza Oportunidades <no-reply@localhost>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Atrás de proxy/reverse proxy (nº de proxies), para rate limiting por IP correcto
TRUST_PROXY=0

# Integrações: só preencher se o INAGBE/parceiro fornecer formalmente um feed JSON autorizado
# INAGBE_AUTHORIZED_FEED_URL=

# Provisionamento do primeiro admin (usado só por `npm run admin:create`)
# ADMIN_EMAIL=
# ADMIN_NAME=
LOG_LEVEL=info
