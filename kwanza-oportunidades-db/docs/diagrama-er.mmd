    uuid id PK
    string name
    string officialUrl
  }
  ScholarshipSourceLink {
    uuid id PK
    uuid scholarshipId FK
    uuid sourceId FK
  }
  ScholarshipFavorite {
    uuid id PK
    uuid userId FK
    uuid scholarshipId FK
  }
