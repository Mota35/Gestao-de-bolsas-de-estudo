erDiagram
  User ||--o| StudentProfile : has
  User ||--o| MentorProfile : has
  User ||--o{ PasswordResetToken : requests
  User ||--o{ EmailVerificationToken : confirms
  User ||--o{ RefreshToken : owns
  User ||--o{ Notification : receives
  User ||--o{ ScholarshipFavorite : saves
  User ||--o{ Application : tracks
  User ||--o{ MentorshipInquiry : sends
  User o|--o{ AuditLog : performs
  User o|--o{ MentorProfile : reviews
  User o|--o{ Scholarship : verifies
  MentorProfile ||--o{ MentorService : offers
  MentorProfile ||--o{ Course : teaches
  MentorService ||--o{ MentorshipInquiry : receives
  Scholarship ||--o{ ScholarshipFavorite : saved_by
